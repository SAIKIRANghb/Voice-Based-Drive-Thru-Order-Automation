# Gemini API Configuration
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_LLM_TIMEOUT_SECONDS=20
GEMINI_LLM_RETRIES=1
TOOL_TIMEOUT_MS=1500
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Zephyr
GEMINI_TTS_TEMPERATURE=1
# Set to 0 to use browser speech synthesis and avoid Gemini TTS quota usage.
ENABLE_GEMINI_TTS=1

# ASR (Automatic Speech Recognition) - Whisper Configuration
WHISPER_MODEL_SIZE=medium.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
PRELOAD_WHISPER_ASR=1
WHISPER_CACHE_DIR=
CT2_CUDA_DLL_DIRS=

# VAD (Voice Activity Detection)
USE_SILERO_VAD=1
PRELOAD_SILERO_VAD=1

# Speaker Recognition / Enrollment
SPEAKER_ENROLLMENT_PATH=
LIVE_DIARIZATION=1
LIVE_DIARIZATION_SIMILARITY=0.45
LIVE_DIARIZATION_MIN_SECONDS=0.7

# SpeechBrain Cache Directory (optional, defaults to ~/.cache/speechbrain)
SPEECHBRAIN_CACHE_DIR=

# Flask/SocketIO Configuration
FLASK_ENV=development
SECRET_KEY=your_secret_key_here
# Use threading by default. Set to eventlet only if you specifically need it.
SOCKETIO_ASYNC_MODE=threading
CRASH_LOG_PATH=crash.log

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=True

# Qdrant RAG menu/catalog retrieval
# Leave QDRANT_URL empty to use an embedded local Qdrant store under cache/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=drive_thru_menu_knowledge
QDRANT_LOCAL_PATH=cache/qdrant
QDRANT_VECTOR_SIZE=384
QDRANT_RECREATE_COLLECTION_ON_MISMATCH=1
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Downloads into this cache when the model is missing; restarts reuse it.
SENTENCE_TRANSFORMER_CACHE=cache/sentence-transformers
# auto downloads when missing, then uses the local cache on later runs.
SENTENCE_TRANSFORMER_LOCAL_FILES_ONLY=auto
PRELOAD_MENU_RAG=1
